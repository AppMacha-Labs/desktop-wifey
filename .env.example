# Copy to .env (dev) or ~/Library/Application Support/desktop-wifey/.env (packaged app).
# Everything is optional. Without ANTHROPIC_API_KEY she uses built-in canned lines.
#
# Names, schedule and behaviour below only seed her preferences on the very first
# launch. After that, change them in her window (double-click her, or 💕 → Open);
# they're saved to settings.json next to this file.

# Her name, your name, and (optionally) a pet name she calls you.
WIFE_NAME=Wifey
USER_NAME=babe
# PET_NAME=

# Makes her improvise every line. https://platform.claude.com
ANTHROPIC_API_KEY=
# WIFEY_MODEL=claude-opus-5-5

# Her voice (ElevenLabs text-to-speech). Without a key she stays silent.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs voice library; the default is a stock voice.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_v4_turbo

# Only needed to make your own animated clips (`npm run clips`). https://fal.ai/dashboard/keys
FAL_KEY=
# WIFEY_VIDEO_MODEL=minimax/h3/image-to-video
# WIFEY_VIDEO_RESOLUTION=768P
# Which character folder the art scripts work on (default art/private).
# WIFEY_ART=art/private

# Schedule (local time). Reminders escalate if you ignore them.
WATER_INTERVAL_MIN=60
MEAL_TIMES=13:00,20:00
BEDTIME=23:30
NAG_AFTER_MIN=10
SNOOZE_MIN=15
MAX_NAGS=3

# Presence. By default she stays off-screen and drops in from the top when she
# has something to say (or when you summon her), then runs off after LINGER_SEC
# of quiet. ALWAYS_VISIBLE=true keeps her on screen all the time.
ALWAYS_VISIBLE=false
SUMMON_SHORTCUT=Alt+Control+W
LINGER_SEC=6
