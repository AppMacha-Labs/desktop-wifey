{
  "name": "desktop-wifey",
  "productName": "desktop-wifey",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny cartoon wife who lives on your desktop and makes sure you drink water, eat and sleep.",
  "keywords": [
    "electron",
    "desktop-pet",
    "companion",
    "claude",
    "reminders"
  ],
  "license": "MIT",
  "author": {
    "name": "AppMacha Labs"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "clips": "node scripts/clips.mjs",
    "pose": "node scripts/pose.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@fal-ai/client": "^1.10.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "44.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dotenv": "^18.0.8",
    "electron-squirrel-startup": "^1.0.1",
    "zod": "^4.6.7"
  }
}
